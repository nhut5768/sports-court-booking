# Copy to deploy/.env on the SERVER, chmod 600. Never commit secrets.
# Hostname only, no https:// or trailing slash.
SITE_HOST=your-unique-name.duckdns.org
ACME_EMAIL=you@example.com
# Generate two DIFFERENT random passwords (openssl rand -hex 32).
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
